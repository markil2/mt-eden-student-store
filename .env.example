# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key — safe for the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key — SERVER ONLY. Never share it or commit it.
SUPABASE_SERVICE_ROLE_KEY=
